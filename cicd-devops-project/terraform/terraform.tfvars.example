# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is git-ignored and must NEVER be committed.
#
#   cp terraform.tfvars.example terraform.tfvars

aws_region          = "ap-south-1"        # USER MUST PROVIDE / CONFIRM
availability_zone   = "ap-south-1a"       # USER MUST PROVIDE / CONFIRM
project_name        = "cicd-devops-project"
environment         = "production"

vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"

instance_type       = "t2.micro"
key_pair_name       = "YOUR_EC2_KEY_PAIR_NAME"   # USER MUST PROVIDE
ssh_allowed_cidr    = "YOUR_IP_ADDRESS/32"       # USER MUST PROVIDE

app_port            = 5000
docker_image        = "YOUR_DOCKERHUB_USERNAME/cicd-demo-app:latest" # USER MUST PROVIDE
